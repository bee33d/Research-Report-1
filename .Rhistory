transmute(
r_squared = r.squared,
adj_r_squared = adj.r.squared,
sigma = sigma,
statistic_F = statistic,
p_value_model = p.value,
df_model = df,
n_obs = nobs
)
knitr::kable(h2_coefs, digits = 4, caption = "H2 linear model coefficients")
knitr::kable(h2_glance, digits = 4, caption = "H2 model fit summary")
