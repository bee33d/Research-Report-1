"Minimum expected cell count",
"Any expected count < 5?",
"Any expected count < 1?"
),
value = c(
min(chisq_h1$expected),
any(chisq_h1$expected < 5),
any(chisq_h1$expected < 1)
)
)
knitr::kable(h1_assumptions, digits = 4, caption = "H1 chi-square assumption checks")
